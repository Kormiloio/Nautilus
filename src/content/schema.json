{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "languagePack": { "$ref": "#/definitions/languagePack" },
    "curriculum": { "$ref": "#/definitions/curriculum" },
    "topics": {
      "type": "array",
      "items": { "$ref": "#/definitions/topic" }
    },
    "bonusTopics": {
      "type": "array",
      "items": { "$ref": "#/definitions/topic" }
    }
  },
  "required": ["languagePack", "curriculum", "topics", "bonusTopics"],
  "additionalProperties": false,
  "definitions": {
    "languagePack": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "targetLanguage": { "$ref": "#/definitions/languageIdentity" },
        "supportLanguage": { "$ref": "#/definitions/supportLanguageIdentity" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "status": { "type": "string", "enum": ["draft", "review", "published", "retired"] },
        "audio": { "$ref": "#/definitions/audioProfile" }
      },
      "required": ["id", "targetLanguage", "supportLanguage", "version", "status"],
      "additionalProperties": false
    },
    "audioProfile": {
      "type": "object",
      "properties": {
        "locale": { "type": "string", "minLength": 2 },
        "delivery": { "type": "string", "enum": ["recorded", "speech-synthesis-draft", "none"] },
        "reviewStatus": { "type": "string", "enum": ["draft", "audio-reviewed", "publishable"] },
        "note": { "type": "string" }
      },
      "required": ["locale", "delivery", "reviewStatus"],
      "additionalProperties": false
    },
    "languageIdentity": {
      "type": "object",
      "properties": {
        "code": { "type": "string", "minLength": 2, "maxLength": 3 },
        "name": { "type": "string", "minLength": 1 },
        "scripts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][a-z]{3}$" }
        }
      },
      "required": ["code", "name", "scripts"],
      "additionalProperties": false
    },
    "supportLanguageIdentity": {
      "type": "object",
      "properties": {
        "code": { "type": "string", "minLength": 2, "maxLength": 3 },
        "name": { "type": "string", "minLength": 1 }
      },
      "required": ["code", "name"],
      "additionalProperties": false
    },
    "curriculum": {
      "type": "object",
      "properties": {
        "months": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "string" }
          }
        },
        "extras": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "string" }
        }
      },
      "required": ["months", "extras"],
      "additionalProperties": false
    },
    "topic": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "month": { "type": "integer", "minimum": 1, "maximum": 12 },
        "bucket": { "type": "integer", "minimum": 0 },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "icon": { "type": "string" },
        "color": { "type": "string" },
        "note": { "type": "string" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/definitions/item" }
        },
        "dialogue": { "$ref": "#/definitions/dialogue" },
        "unlockDate": { "type": "string" }
      },
      "required": ["id", "title", "subtitle", "icon", "color", "items"],
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "targetText": { "type": "string", "minLength": 1 },
        "supportText": { "type": "string", "minLength": 1 },
        "emoji": { "type": "string" },
        "reviewStatus": {
          "type": "string",
          "enum": ["draft", "language-reviewed", "audio-reviewed", "publishable"],
          "default": "draft"
        },
        "audioUrl": { "type": "string" }
      },
      "required": ["id", "targetText", "supportText"],
      "additionalProperties": false
    },
    "dialogue": {
      "type": "object",
      "properties": {
        "roles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "lines": {
          "type": "array",
          "items": { "$ref": "#/definitions/dialogueLine" }
        }
      },
      "required": ["roles", "lines"],
      "additionalProperties": false
    },
    "dialogueLine": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "role": { "type": "string" },
        "targetText": { "type": "string", "minLength": 1 },
        "supportText": { "type": "string", "minLength": 1 },
        "reviewStatus": {
          "type": "string",
          "enum": ["draft", "language-reviewed", "audio-reviewed", "publishable"],
          "default": "draft"
        },
        "audioUrl": { "type": "string" }
      },
      "required": ["id", "role", "targetText", "supportText"],
      "additionalProperties": false
    }
  }
}
